{
  "close_on_focus_loss": false,
  "search_files_in_root": false,
  "escape_key_behavior": "navigate_back",
  "consider_preedit": false,
  "pop_to_root_on_close": true,
  "favicon_service": "google",
  "keybinding": "default",
  "font": {
    "normal": {
      "family": "auto",
      "size": 11
    }
  },
  "launcher_window": {
    "opacity": 0.9,
    "compact_mode": {
      "enabled": false
    },
    "size": {
      "width": 700,
      "height": 580
    },
    "client_side_decorations": {
      "enabled": true,
      "rounding": 20,
      "border_width": 4
    }
  },
  "favorites": [
    "clipboard:history",
    "files:search"
  ],
  "fallbacks": [
    "files:search"
  ]
}
