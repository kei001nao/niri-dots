{
  "version": 1,
  "theme": "matugen",
  "locale": "ja",
  "file_browser": {
    "show_hidden": true
  },
  "languages": {
    "kdl": {
      "extensions": [
        "kdl"
      ],
      "grammar": "Niri Config",
      "comment_prefix": "//",
      "auto_indent": true,
      "highlighter": "auto",
      "show_whitespace_tabs": true,
      "use_tabs": false,
      "tab_size": 2,
      "format_on_save": false
    },
    "toml": {
      "tab_size": 2
    },
    "typescript": {
      "tab_size": 2
    },
    "json": {
      "tab_size": 2
    },
    "yaml": {
      "tab_size": 2
    },
    "bash": {
      "tab_size": 2
    }
  }
}